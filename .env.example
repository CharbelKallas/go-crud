# Copy to .env and fill in every empty value. Never commit .env.
# The secrets are deliberately empty: docker compose and the app refuse to
# start until you set them, so a copied example can never run with
# publicly known values.
#
# Generate passwords with: openssl rand -hex 24

MYSQL_ROOT_PASSWORD=
DB_USERNAME=app
DB_PASSWORD=
DB_DATABASE=recordings

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Token lifetimes (Go durations).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=12h

# Login/signup/refresh attempts allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=10

# weatherapi.com key. Leave empty to disable /api/weather (it answers 503).
WEATHER_API_KEY=

# Optional: sign weather API requests (both or neither).
WEATHER_SIGNING_SECRET=
WEATHER_SIGNING_CLIENT_ID=
