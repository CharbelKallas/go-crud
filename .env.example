# Copy to .env and replace every value. Never commit .env.
# Generate strong values with: openssl rand -base64 32

MYSQL_ROOT_PASSWORD=change-me
DB_USERNAME=app
DB_PASSWORD=change-me
DB_DATABASE=recordings

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-bytes

# Token lifetimes (Go durations).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=12h

# weatherapi.com key. Leave empty to disable /api/weather (it answers 503).
WEATHER_API_KEY=

# Optional: sign weather API requests (both or neither).
WEATHER_SIGNING_SECRET=
WEATHER_SIGNING_CLIENT_ID=
